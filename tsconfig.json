{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    // Scripts import src modules by .ts path; noEmit makes this safe.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // tests/, bench/, and scripts/ are listed because tsc is the only thing that
  // typechecks them: Vitest strips types rather than checking them.
  "include": ["src", "test", "bench", "scripts", "*.config.ts"]
}
